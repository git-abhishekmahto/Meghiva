<?xml version='1.0' encoding='utf-8'?>
<widget id="com.meghanix.meghanix" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>meghanix</name> 
    <description>meghanix</description> 
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org"> 
        meghanix
    </author>
    <content src="index.html" />
    <preference name="ErrorUrl" value="index.html"/>
    <preference name="DisallowOverscroll" value="true" />
	<preference name="android-targetSdkVersion" value="34"/>
    <preference name="AndroidXEnabled" value="true" />
    <!-- new by ash -->
    <plugin name = "cordova-plugin-network-information" source="npm" spec="3.0.0" />
    <plugin name = "cordova-plugin-inappbrowser"/>
    
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.jpg" />
    <platform name="android">
        <icon src="res/icon.jpg"/>
    </platform>
    <engine name="android" spec="12.0.0" />
</widget>